<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: 温润莫奈暗色悬浮内胆底板 (16dp 圆角与细腻微晶描边，彻底移除断层横线) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#FF202430"
                android:endColor="#FF191C26"
                android:type="linear" />
            <stroke
                android:width="0.7dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
