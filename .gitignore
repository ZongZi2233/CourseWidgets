# ─────────────────────────────────────────────────────────────
# CourseWidgets .gitignore
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# 1. 签名证书、密钥与隐私配置文件 (Signing Keys, Keystores & Secrets)
# ─────────────────────────────────────────────────────────────
*.jks
*.keystore
*.p12
*.key
*.pem
*.cer
*.crt
my-release-key.jks
key.properties
android/key.properties

# ─────────────────────────────────────────────────────────────
# 2. 本地机器配置、环境变量与临时缓存 (Local Environment & Machine Config)
# ─────────────────────────────────────────────────────────────
local.properties
**/local.properties
.env
.env.*
*.env
**/ephemeral/
.gradle/
**/.gradle/

# ─────────────────────────────────────────────────────────────
# 3. Flutter / Dart / 构建产物 (Flutter & Build Artifacts)
# ─────────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id

# ─────────────────────────────────────────────────────────────
# 4. 发布归档包与调试符号 (Release Binaries & Debug Symbols)
# ─────────────────────────────────────────────────────────────
/release/*.apk
/release/*.zip
/symbols/
/debug-info/
/scratch/
app.*.symbols
app.*.map.json
*.apk
*.aab
*.zip

# Android 构建中间体
/android/app/debug
/android/app/profile
/android/app/release

# ─────────────────────────────────────────────────────────────
# 5. 编辑器与 IDE (IDE & Editor Settings)
# ─────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
.clinerules/

# ─────────────────────────────────────────────────────────────
# 6. 操作系统与临时文件 (OS Artifacts & Temp Files)
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.class
*.log
*.pyc
*.pyo
*.pyd
__pycache__/
*.swp
*~
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
